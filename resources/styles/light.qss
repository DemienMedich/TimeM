/* Светлая тема для приложения управления временем */

/* Основные цвета */
QWidget {
    background-color: #f5f5f5;
    color: #333333;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Главное окно */
QMainWindow {
    background-color: #f5f5f5;
}

/* Панель инструментов */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    spacing: 5px;
    padding: 2px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
}

QToolBar QToolButton:hover {
    background-color: #e6f2ff;
    border: 1px solid #b3d9ff;
}

QToolBar QToolButton:pressed {
    background-color: #cce6ff;
}

/* Строка состояния */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e0e0e0;
}

QStatusBar QLabel {
    padding: 3px;
}

/* Вкладки */
QTabWidget::pane {
    border: 1px solid #e0e0e0;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f0f0f0;
    border: 1px solid #e0e0e0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom: 1px solid #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #e6f2ff;
}

/* Кнопки */
QPushButton {
    background-color: #0078d7;
    color: white;
    border: 1px solid #0067b8;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #1a88e1;
}

QPushButton:pressed {
    background-color: #006cc1;
}

QPushButton:disabled {
    background-color: #cccccc;
    border: 1px solid #b3b3b3;
    color: #666666;
}

/* Поля ввода */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #0078d7;
    selection-color: white;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #0078d7;
}

/* Выпадающие списки */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
    min-width: 6em;
}

QComboBox:hover {
    border: 1px solid #0078d7;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #cccccc;
}

QComboBox::down-arrow {
    image: url(:/icons/dropdown.png);
}

QComboBox QAbstractItemView {
    border: 1px solid #cccccc;
    selection-background-color: #0078d7;
    selection-color: white;
    background-color: white;
}

/* Флажки и переключатели */
QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    border: 1px solid #cccccc;
    background-color: white;
}

QCheckBox::indicator:checked {
    border: 1px solid #0078d7;
    background-color: #0078d7;
    image: url(:/icons/checkmark.png);
}

QRadioButton::indicator:checked {
    border: 1px solid #0078d7;
    background-color: white;
    image: url(:/icons/radiobutton.png);
}

/* Полосы прокрутки */
QScrollBar:vertical {
    border: none;
    background-color: #f0f0f0;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f0f0f0;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Таблицы */
QTableView {
    gridline-color: #e0e0e0;
    background-color: white;
    selection-background-color: #e6f2ff;
    selection-color: #333333;
    border: 1px solid #e0e0e0;
}

QTableView::item {
    padding: 4px;
}

QTableView::item:selected {
    background-color: #e6f2ff;
    color: #333333;
}

QHeaderView::section {
    background-color: #f0f0f0;
    padding: 4px;
    border: 1px solid #e0e0e0;
    border-top: none;
    border-left: none;
}

/* Списки */
QListView {
    background-color: white;
    border: 1px solid #e0e0e0;
    selection-background-color: #e6f2ff;
    selection-color: #333333;
}

QListView::item {
    padding: 4px;
}

QListView::item:selected {
    background-color: #e6f2ff;
    color: #333333;
}

/* Группы */
QGroupBox {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 3px;
}

/* Индикаторы прогресса */
QProgressBar {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    background-color: #f0f0f0;
    text-align: center;
    color: #333333;
}

QProgressBar::chunk {
    background-color: #0078d7;
    width: 1px;
}

/* Меню */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
}

QMenuBar::item {
    spacing: 6px;
    padding: 4px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #e6f2ff;
    border: 1px solid #b3d9ff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
}

QMenu::item {
    padding: 6px 24px 6px 24px;
}

QMenu::item:selected {
    background-color: #e6f2ff;
    color: #333333;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 0px;
}

/* Диалоги */
QDialog {
    background-color: #f5f5f5;
}

QDialogButtonBox {
    button-layout: 3;
}

/* Графики */
QChartView {
    background-color: white;
    border: 1px solid #e0e0e0;
}

/* Специфические стили для виджетов приложения */

/* Таймер Помодоро */
#timerLabel {
    font-size: 48px;
    font-weight: bold;
    color: #0078d7;
}

#sessionTypeLabel {
    font-size: 18px;
    font-weight: bold;
}

/* Виджет отслеживания времени */
#timeLabel {
    font-size: 32px;
    font-weight: bold;
    color: #0078d7;
}

/* Виджет задач - приоритеты */
.priority-1 {
    color: #d9534f; /* Красный - Срочно и Важно */
}

.priority-2 {
    color: #f0ad4e; /* Оранжевый - Важно, Не срочно */
}

.priority-3 {
    color: #5bc0de; /* Синий - Срочно, Не важно */
}

.priority-4 {
    color: #5cb85c; /* Зеленый - Не срочно и Не важно */
}