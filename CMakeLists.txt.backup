cmake_minimum_required(VERSION 3.10)
project(TimeManagementApp)

# Set C++ standard
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Include directories
include_directories(include)

# Source files
set(SOURCES
    src/main.cpp
    src/Task.cpp
    src/TimeTracker.cpp
    src/PomodoroTimer.cpp
    src/TaskManager.cpp
    src/FileManager.cpp
    src/UserInterface.cpp
)

# Create executable
add_executable(TimeManagementApp ${SOURCES})

# Add compiler flags
if(MSVC)
    target_compile_options(TimeManagementApp PRIVATE /W4)
else()
    target_compile_options(TimeManagementApp PRIVATE -Wall -Wextra -pedantic)
endif()

# Install target
install(TARGETS TimeManagementApp
    RUNTIME DESTINATION bin
)